<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is denied by default; the self-hosted box is the one exception.

  The update check + APK download go to the personal VPS (see
  UpdateCheckerImpl.defaultManifestUrl), which serves plain HTTP on an IP
  with no certificate — a bare IP cannot get a Let's Encrypt cert, and the
  app rejects a self-signed one. Rather than flipping the global
  `usesCleartextTraffic` switch, allow exactly that origin so every other
  destination keeps enforcing TLS.

  Note the relay WebSocket does NOT need an entry here: it uses Dart's
  IOWebSocketChannel (a raw socket), which is outside Android's cleartext
  policy. This is only for the Dart HttpClient path that dio uses.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- Personal VPS: static APK + update manifest host. -->
        <domain includeSubdomains="false">1.15.13.177</domain>
    </domain-config>
</network-security-config>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is required for the relay WebSocket. Debug and profile
         manifests already declare it for hot-reload, but the release
         build inherits only from src/main; without this line a signed
         APK ships with no network access at all. ACCESS_NETWORK_STATE
         lets the app detect offline state without polling. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Plan 29 — voice input. RECORD_AUDIO feeds on-device speech
         recognition; audio is transcribed locally and never written to a
         file nor sent to any server. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Plan 30 — image attachments. CAMERA covers the photo-capture path;
         the gallery uses the Android Photo Picker (no storage permission). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- In-app update (plan 44): the app downloads the release APK and hands
         it to the system installer. Android requires this permission to
         launch that installer; it grants no silent-install ability (the OS
         still shows its own confirmation), and the user must additionally
         allow "install unknown apps" for this app the first time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Background delivery. The app keeps one WebSocket to the relay alive
         while backgrounded, which Android only tolerates for a foreground
         service — hence FOREGROUND_SERVICE plus the SPECIAL_USE type (see
         ConnectionKeeperService for why not dataSync). POST_NOTIFICATIONS is
         the Android 13+ runtime prompt for the "turn finished" notices;
         without it the service still runs, it just cannot show them.
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS backs the "battery: unrestricted"
         row — Doze exempts foreground services, but aggressive OEM battery
         managers do not, and only this list reaches them. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- VIBRATE is what makes the buzz possible at all. Playing any vibration
         effect — a channel's pattern included — requires it, and without the
         declaration the platform silently drops the vibration: the notification
         arrives, silent and still, with nothing in the app pointing at why. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <application
        android:label="Remote Pi"
        android:name="${applicationName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Background connection — holds the process in the foreground so the
             Dart isolate's relay WebSocket survives backgrounding. `specialUse`
             (not dataSync, capped at 6h/day from Android 15) needs the subtype
             property below to state the purpose. stopWithTask=false is the
             default but stated explicitly: pressing Home must not tear the
             connection down. Swiping the app out of recents does, on purpose
             (see ConnectionKeeperService.onTaskRemoved). -->
        <service
            android:name=".ConnectionKeeperService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent_messaging_connection" />
        </service>
        <!-- In-app update: exposes the downloaded APK to the system installer.
             Android refuses a file:// URI across apps, so the installer gets
             a content:// URI via this provider backed by the app's own cache
             dir. `grantUriPermissions` lets the installer read exactly that
             one file; nothing else under cache/ is reachable. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Plan 29 — Android 11+ (API 30) package visibility: lets
             speech_to_text discover the on-device recognition service.
             Without this, locales()/listen() find no provider. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Plan 32b — url_launcher opening https links from rendered
             markdown (Android 11+ package visibility). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
